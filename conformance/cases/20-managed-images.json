{
  "id": "managed-images",
  "tags": [
    "documented-only"
  ],
  "steps": [
    {
      "name": "list",
      "operation": "ListManagedMicrovmImages",
      "method": "GET",
      "path": "/2025-09-09/managed-microvm-images",
      "expect": {
        "status": 200
      },
      "capture": {
        "managedImageArn": "items.0.imageArn"
      }
    },
    {
      "name": "list-versions",
      "operation": "ListManagedMicrovmImageVersions",
      "method": "GET",
      "path": "/2025-09-09/managed-microvm-images/${managedImageArn}/versions",
      "expect": {
        "status": 200
      }
    }
  ]
}
