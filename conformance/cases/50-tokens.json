{
  "id": "tokens",
  "params": {
    "baseImageArn": "arn:aws:lambda:us-east-1:aws:microvm-image:al2023-1",
    "buildRoleArn": "arn:aws:iam::123456789012:role/m80-conformance-build",
    "codeArtifactUri": "s3://m80-conformance/code.zip"
  },
  "tags": ["documented-only"],
  "steps": [
    {
      "name": "create-image",
      "operation": "CreateMicrovmImage",
      "method": "POST",
      "path": "/2025-09-09/microvm-images",
      "body": {
        "name": "m80-conf-token-image",
        "baseImageArn": "${baseImageArn}",
        "buildRoleArn": "${buildRoleArn}",
        "codeArtifact": { "uri": "${codeArtifactUri}" }
      },
      "expect": { "status": 201 },
      "capture": { "imageName": "name", "imageVersion": "imageVersion" }
    },
    {
      "name": "version-until-built",
      "operation": "GetMicrovmImageVersion",
      "method": "GET",
      "path": "/2025-09-09/microvm-images/${imageName}/versions/${imageVersion}",
      "expect": { "status": 200 },
      "until": { "path": "state", "equals": "SUCCESSFUL", "timeoutSec": 2700, "intervalSec": 10 }
    },
    {
      "name": "run",
      "operation": "RunMicrovm",
      "method": "POST",
      "path": "/2025-09-09/microvms",
      "body": { "imageIdentifier": "${imageName}" },
      "expect": { "status": 200 },
      "capture": { "microvmId": "microvmId" }
    },
    {
      "name": "get-until-running",
      "operation": "GetMicrovm",
      "method": "GET",
      "path": "/2025-09-09/microvms/${microvmId}",
      "expect": { "status": 200 },
      "until": { "path": "state", "equals": "RUNNING", "timeoutSec": 600, "intervalSec": 5 }
    },
    {
      "name": "auth-token",
      "operation": "CreateMicrovmAuthToken",
      "method": "POST",
      "path": "/2025-09-09/microvms/${microvmId}/auth-token",
      "body": { "expirationInMinutes": 60, "allowedPorts": [{ "allPorts": true }] },
      "expect": { "status": 200 }
    },
    {
      "name": "shell-auth-token",
      "operation": "CreateMicrovmShellAuthToken",
      "method": "POST",
      "path": "/2025-09-09/microvms/${microvmId}/shell-auth-token",
      "body": { "expirationInMinutes": 60 },
      "expect": { "status": 200 }
    },
    {
      "name": "terminate",
      "operation": "TerminateMicrovm",
      "method": "DELETE",
      "path": "/2025-09-09/microvms/${microvmId}",
      "expect": { "status": 200 }
    },
    {
      "name": "delete-image",
      "operation": "DeleteMicrovmImage",
      "method": "DELETE",
      "path": "/2025-09-09/microvm-images/${imageName}",
      "expect": { "status": 200 }
    }
  ]
}
