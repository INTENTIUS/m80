{
  "id": "vms-lifecycle",
  "params": {
    "baseImageArn": "arn:aws:lambda:${region}:aws:microvm-image:al2023-1",
    "buildRoleArn": "arn:aws:iam::123456789012:role/m80-conformance-build",
    "codeArtifactUri": "s3://m80-conformance-123456789012-use2/code.zip"
  },
  "tags": [
    "documented-only",
    "subset:floci"
  ],
  "steps": [
    {
      "name": "create-image",
      "operation": "CreateMicrovmImage",
      "method": "POST",
      "path": "/2025-09-09/microvm-images",
      "body": {
        "name": "m80-conf-vm-image",
        "baseImageArn": "${baseImageArn}",
        "buildRoleArn": "${buildRoleArn}",
        "codeArtifact": {
          "uri": "${codeArtifactUri}"
        }
      },
      "expect": {
        "status": 201
      },
      "capture": {
        "imageName": "name",
        "imageVersion": "imageVersion",
        "imageArn": "imageArn"
      }
    },
    {
      "name": "version-until-built",
      "operation": "GetMicrovmImageVersion",
      "method": "GET",
      "path": "/2025-09-09/microvm-images/${imageArn}/versions/${imageVersion}",
      "expect": {
        "status": 200
      },
      "until": {
        "path": "state",
        "equals": "SUCCESSFUL",
        "timeoutSec": 2700,
        "intervalSec": 10
      }
    },
    {
      "name": "run",
      "operation": "RunMicrovm",
      "method": "POST",
      "path": "/2025-09-09/microvms",
      "body": {
        "imageIdentifier": "${imageArn}"
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "microvmId": "microvmId"
      }
    },
    {
      "name": "get-until-running",
      "operation": "GetMicrovm",
      "method": "GET",
      "path": "/2025-09-09/microvms/${microvmId}",
      "expect": {
        "status": 200
      },
      "until": {
        "path": "state",
        "equals": "RUNNING",
        "timeoutSec": 600,
        "intervalSec": 5
      }
    },
    {
      "name": "list",
      "operation": "ListMicrovms",
      "method": "GET",
      "path": "/2025-09-09/microvms",
      "expect": {
        "status": 200,
        "itemShape": {
          "path": "items",
          "required": [
            "imageArn",
            "imageVersion",
            "microvmId",
            "startedAt",
            "state"
          ],
          "exact": true,
          "minItems": 1
        }
      }
    },
    {
      "name": "terminate",
      "operation": "TerminateMicrovm",
      "method": "DELETE",
      "path": "/2025-09-09/microvms/${microvmId}",
      "expect": {
        "status": 200
      }
    },
    {
      "name": "get-until-terminated",
      "operation": "GetMicrovm",
      "method": "GET",
      "path": "/2025-09-09/microvms/${microvmId}",
      "expect": {
        "status": 200
      },
      "until": {
        "path": "state",
        "equals": "TERMINATED",
        "timeoutSec": 600,
        "intervalSec": 5
      }
    },
    {
      "name": "delete-image",
      "operation": "DeleteMicrovmImage",
      "method": "DELETE",
      "path": "/2025-09-09/microvm-images/${imageArn}",
      "expect": {
        "status": 200
      }
    }
  ]
}
